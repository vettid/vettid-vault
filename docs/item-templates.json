{
  "format": 1,
  "version": 1,
  "spec": "VAULT-MESSAGING 0.7.0 §10.7",
  "description": "Recommended item categories and templates the apps share. Templates live in the apps, not in the vault: choosing one pre-fills labelled fields, suggests tags and a sensitivity; the member can add, remove or rename anything, and free-form items need no template. The vault checks only shapes and sizes (§10.7). A template's id goes into item.template, opaque to the vault. Labels are English defaults for the apps to translate; kinds are the field kinds of §10.7.",
  "categories": [
    { "category": "identity_document", "label": "Identity document", "icon": "id-card" },
    { "category": "login", "label": "Login", "icon": "key" },
    { "category": "payment_card", "label": "Payment card", "icon": "credit-card" },
    { "category": "bank_account", "label": "Bank account", "icon": "bank" },
    { "category": "medical", "label": "Medical", "icon": "medical" },
    { "category": "insurance", "label": "Insurance", "icon": "shield" },
    { "category": "vehicle", "label": "Vehicle", "icon": "car" },
    { "category": "contact", "label": "Contact", "icon": "person" },
    { "category": "note", "label": "Note", "icon": "note" },
    { "category": "crypto_wallet", "label": "Crypto wallet", "icon": "wallet" },
    { "category": "other", "label": "Other", "icon": "folder" }
  ],
