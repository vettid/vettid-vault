# VettID's changes to AWS's Nitro Enclaves kernel config
# (aws/kernel/microvm-kernel-config-aarch64, aws-nitro-enclaves-sdk-bootstrap
# v6.6.79). kernel.nix appends this file to AWS's config and runs
# `make olddefconfig`; check-config.sh then requires every line below to
# hold in the resulting .config, so an option that Kconfig silently drops
# or overrides fails the build. docs/KERNEL.md gives the reasons.
# Each change here is a change on a security path: reviewed like code.

# --- Modules: none. The NSM driver is built in. ---
# With no module loading at all there is no module signing key to keep
# (and none to make reproducible); init's nsm.ko is an empty placeholder
# (patches/init-builtin-nsm.patch).
# CONFIG_MODULES is not set
CONFIG_NSM=y

# --- Security modules ---
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y
CONFIG_LSM="lockdown,yama"
CONFIG_SECURITY_DMESG_RESTRICT=y

# --- Interfaces the enclave does not use ---
# No bpf(2) at all: seccomp filters are classic BPF and need none of it.
# The supervisor accepts a missing kernel.unprivileged_bpf_disabled only
# where an unfiltered bpf(2) answers ENOSYS.
# CONFIG_BPF_SYSCALL is not set
# The supervisor also closes user namespaces (max_user_namespaces=0) and
# the vault processes' seccomp filter denies io_uring; here they do not
# exist at all.
# IO_URING can be switched off only with EXPERT (which only exposes
# prompts; it selects DEBUG_KERNEL, which AWS's config already has).
CONFIG_EXPERT=y
# CONFIG_USER_NS is not set
# CONFIG_IO_URING is not set
# CONFIG_COMPAT is not set
# CONFIG_USERFAULTFD is not set
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_BINFMT_MISC is not set
# CONFIG_HIBERNATION is not set
CONFIG_PROC_MEM_NO_FORCE=y

# --- Debugging interfaces ---
# CONFIG_DEBUG_FS is not set
# CONFIG_KPROBES is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_DEVMEM is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_PERF_EVENTS is not set

# --- Memory hardening ---
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_RANDOM=y
# CONFIG_SLAB_MERGE_DEFAULT is not set
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_PANIC_ON_OOPS=y

# --- Address space layout randomisation ---
# Takes effect only if the kernel finds a seed at boot (/chosen/kaslr-seed
# or the CPU's RNDR instruction); otherwise it boots at the fixed address
# and logs "KASLR disabled". The hardware run reports which.
CONFIG_RANDOMIZE_BASE=y
